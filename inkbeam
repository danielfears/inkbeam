#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

if ! command -v powershell.exe >/dev/null 2>&1; then
    printf '%s\n' 'Error: powershell.exe is unavailable; this tool requires WSL on Windows.' >&2
    exit 1
fi

windows_script="$(wslpath -w "$script_dir/WhiteboardReceiver.ps1")"
exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$windows_script" "$@"
