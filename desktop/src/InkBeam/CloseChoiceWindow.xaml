<Window
    x:Class="InkBeam.CloseChoiceWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Close InkBeam"
    Width="470"
    Height="245"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="{StaticResource WindowBackgroundBrush}"
    Foreground="{StaticResource TextBrush}"
    SourceInitialized="Window_SourceInitialized"
    Icon="Assets/InkBeam.ico">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock
                FontSize="19"
                FontWeight="SemiBold"
                Text="Keep InkBeam available?" />
            <TextBlock
                Margin="0,10,0,0"
                Style="{StaticResource MutedText}"
                Text="Keeping InkBeam in the notification area leaves the current receiver state unchanged. Exiting stops the managed receiver before the app closes." />
        </StackPanel>
        <WrapPanel
            Grid.Row="1"
            HorizontalAlignment="Right">
            <Button
                Margin="0,0,8,0"
                Style="{StaticResource SecondaryButton}"
                Content="Cancel"
                Click="Cancel_Click" />
            <Button
                Margin="0,0,8,0"
                Style="{StaticResource SecondaryButton}"
                Content="Exit and stop"
                Click="Exit_Click" />
            <Button
                Content="Keep running in tray"
                Click="Tray_Click" />
        </WrapPanel>
    </Grid>
</Window>
